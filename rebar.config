{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [brod, cowboy, jsx, epgsql, prometheus]}.

{profiles, [
  {test, [{deps, [meck, proper]},
          {extra_src_dirs, ["test/unit", "test/ct", "test/pact"]}]},
  %% `rebar3 as prod release`: a self-contained release with ERTS, built by
  %% the production Dockerfile.
  {prod, [{relx, [{mode, prod}]}]}
]}.

%% Lets `rebar3 shell` boot the app with the same config the release uses.
{shell, [{config, "config/sys.config"},
         {apps, [order_app]}]}.

%% mnesia is only loaded: order_mnesia:init/0 starts it once the disc schema
%% exists.
{relx, [{release, {order_processing, "0.1.0"}, [order_app, sasl, {mnesia, load}]},
        {sys_config, "config/sys.config"},
        {vm_args, "config/vm.args"}]}.

%% Mnesia is started by order_mnesia:init/0 (after the disc schema exists),
%% not listed in the app's `applications', so dialyzer must be told about it.
%% kafka_protocol defines the #kafka_message{} types consumer_worker uses.
{dialyzer, [{warnings, [unmatched_returns, error_handling]},
            {plt_extra_apps, [mnesia, kafka_protocol]}]}.
