[
 {order_app, [
   {http_port, 8080},
   %% The app runs in the compose network, so it uses Kafka's INTERNAL listener.
   {kafka_endpoints, [{"kafka", 19092}]},
   {produce_timeout_ms, 5000},
   {max_body_bytes, 65536},
   {consumer_group_id, <<"order_consumers">>},
   {retry_group_id, <<"order_retry">>},
   %% Backoff before retry 1, 2 and 3; after that the order is dead-lettered.
   {retry_delays_ms, [1000, 5000, 30000]},
   %% Where a partition starts when the group has no committed offset yet.
   {consumer_begin_offset, earliest},
   {offset_commit_interval_seconds, 5},
   {consumer_shutdown_ms, 10000},
   {producer_shutdown_ms, 10000},
   {call_timeout_ms, 5000},
   %% order_store_pg (system of record) or order_store_mnesia. Idempotency
   %% keys and the simulated gateway's memory stay in Mnesia either way.
   {store_impl, order_store_pg},
   %% Local development only; matches docker-compose.yml.
   {pg, #{host => "postgres", port => 5432, username => "orders",
          password => "orders", database => "orders", timeout => 5000}},
   {pg_statement_timeout_ms, 5000},
   {mnesia_copies, disc_copies},
   {mnesia_wait_ms, 5000},
   %% Simulated gateway failure rates (0.0 - 1.0). Timeouts are retried;
   %% declines are dead-lettered at once.
   {gateway_timeout_rate, 0.1},
   {gateway_decline_rate, 0.02}
 ]},
 %% On a Docker volume, so orders survive container restarts.
 {mnesia, [{dir, "/var/lib/order_app/mnesia"}]},
 {kernel, [{logger_level, info}]}
].
