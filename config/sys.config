[
 {order_app, [
   {http_port, 8080},
   %% The app runs in the compose network, so it uses Kafka's INTERNAL listener.
   {kafka_endpoints, [{"kafka", 19092}]},
   {produce_timeout_ms, 5000},
   {max_body_bytes, 65536},
   {consumer_group_id, <<"order_consumers">>},
   %% Where a partition starts when the group has no committed offset yet.
   {consumer_begin_offset, earliest},
   {offset_commit_interval_seconds, 5},
   {consumer_shutdown_ms, 10000},
   {producer_shutdown_ms, 10000},
   {call_timeout_ms, 5000},
   {store_impl, order_store_mnesia},
   {mnesia_copies, disc_copies},
   {mnesia_wait_ms, 5000},
   %% Simulated gateway failure rates (0.0 - 1.0). Off until retries exist
   %% (phase 5), because a timeout is dead-lettered until then.
   {gateway_timeout_rate, 0.0},
   {gateway_decline_rate, 0.0}
 ]},
 %% On a Docker volume, so orders survive container restarts.
 {mnesia, [{dir, "/var/lib/order_app/mnesia"}]},
 {kernel, [{logger_level, info}]}
].
